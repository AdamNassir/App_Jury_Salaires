rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    
    function isSignedIn() {
      return request.auth != null;
    }

    function isEmailVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email.matches('(?i)guillaumebestece@gmail\\.com') ||
        request.auth.token.email.matches('(?i)guillaume\\.best@logiclever\\.com') ||
        request.auth.token.email.matches('(?i)adam\\.nassir@logiclever\\.com') ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         (
           get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('roles', []).hasAny(['JURY', 'ADMIN']) ||
           get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') in ['JURY', 'ADMIN']
         )
        )
      );
    }

    function isJury() {
      return isAdmin();
    }

    function hasRole(role) {
      return isAdmin() || (isSignedIn() && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('roles', []).hasAny([role]));
    }

    function isConsultantOnDossier(dossierData) {
      return isSignedIn() && dossierData.get('assignedConsultantIds', []).hasAny([request.auth.uid]);
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    match /users/{userId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn() && (userId == request.auth.uid || isJury());
      allow update: if isSignedIn() && (
        userId == request.auth.uid || 
        isJury()
      );
      allow delete: if isJury();
    }

    function isCampaignClosed(campaignId) {
      return campaignId != null && 
        exists(/databases/$(database)/documents/campaigns/$(campaignId)) &&
        get(/databases/$(database)/documents/campaigns/$(campaignId)).data.get('status', '') == 'CLÔTURÉE';
    }

    match /dossiers/{dossierId} {
      allow read: if isSignedIn();

      allow create: if isSignedIn() && (
        isJury() ||
        (incoming().candidateId == request.auth.uid && incoming().status == 'OUVERT')
      );

      allow update: if isSignedIn() && (
        isJury() ||
        // Candidate updating own dossier before validation and if campaign not closed
        (resource.data.candidateId == request.auth.uid && 
         existing().status != 'VALIDE' && 
         !isCampaignClosed(resource.data.get('campaignId', null))) ||
        // Evaluator / consultant submitting or updating peer review:
        // - Campaign must NOT be closed
        // - Dossier status cannot be forcibly changed to VALIDE by evaluator
        (!isCampaignClosed(resource.data.get('campaignId', null)) &&
         incoming().status != 'VALIDE')
      );
      
      allow delete: if isJury();
    }

    match /campaigns/{campaignId} {
      allow read, create, update, delete: if isSignedIn();
    }

    match /personnes/{personneId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isJury();
    }
  }
}
